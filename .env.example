# Keep MOCK_MODE=true for local development. Mock sessions never submit orders.
MOCK_MODE=true
MOCK_BYBIT_FREE_USDT=200

# Bybit credentials are required only when MOCK_MODE=false.
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_UID=
BYBIT_DOMAIN=bybit.eu
BYBIT_TESTNET=false
BYBIT_ALLOW_MAINNET_TRADING=false
BYBIT_DAILY_START_EQUITY_USDT=

# Avanza credentials are required only when MOCK_MODE=false.
AVANZA_USERNAME=
AVANZA_PASSWORD=
AVANZA_TOTP_SECRET=
AVANZA_POSITIONS_FILE=avanza_positions.json


# Optional Ntfy notifications for portfolio syncs and signal changes.
# Use a private topic and configure NTFY_ACCESS_TOKEN when the server requires it. NTFY_SERVER=https://ntfy.shNTFY_TOPIC=
NTFY_ACCESS_TOKEN=

# JSONL output for realized trades tracked by the live execution stream.
TRADE_ANALYSIS_PATH=data/trade_outcomes.jsonl
